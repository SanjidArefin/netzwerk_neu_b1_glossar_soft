{
  "name": "b1-glossar",
  "version": "1.1.3",
  "description": "An offline German B1 glossary for Netzwerk neu.",
  "main": "backend/main.js",
  "author": "B1 Glossar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check backend/main.js && node --check backend/preload.js && node --check backend/glossary-service.js && node --check frontend/glossary-model.js && node --check frontend/app.js",
    "validate-data": "node tests/validate-data.js",
    "test": "node --test tests/*.test.js",
    "test:electron": "electron tests/electron-smoke.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.b1glossar.app",
    "productName": "B1 Glossar",
    "artifactName": "B1-Glossar-Setup.exe",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "backend/**/*",
      "frontend/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "B1 Glossar",
      "uninstallDisplayName": "B1 Glossar"
    }
  }
}
